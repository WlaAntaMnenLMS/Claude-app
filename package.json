    "better-sqlite3": "^9.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cors": "^2.8.6",
    "date-fns": "^3.3.1",
    "docxtemplater": "^3.47.0",
    "drizzle-orm": "^0.30.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^0.358.0",
    "ollama": "^0.5.0",
    "papaparse": "^5.4.1",
    "pizzip": "^3.1.6",
    "react": "^18.2.0",
    "react-big-calendar": "^1.8.7",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.2"
